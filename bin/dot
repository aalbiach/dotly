#!/usr/bin/env bash

set -o pipefail

source "$DOTLY_PATH/scripts/core/_main.sh"

##? Usage:
##?    dot
##?    dot <context>
##?    dot <context> <script> [<args>...]
##?    dot -h | --help
if [ "$1" == "-h" ] || [ "$1" = "--help" ]; then
	docs::parse "$@"
fi

fzf_prompt() {
	local paths="$1"

	script="$(
		# A single sed keeps streaming into fzf (progressive load) and dies
		# silently on SIGPIPE if fzf is aborted early, unlike an xargs child
		echo "$paths" |
			sed -e 's|.*/scripts/||' -e 's|/| |' |
			fzf \
				--height 100% \
				--preview '"$DOTLY_PATH/bin/dot" $(echo {} | cut -d" " -f 1) $(echo {} | cut -d" " -f 2) -h'
	)"

	# fzf was aborted (Esc/Ctrl-C) without a selection
	[ -z "$script" ] && return 0

	printf "%s" "$script"
	# Ctrl-D (EOF) must not fall through and relaunch the picker
	read -r args || return 0

	"$DOTLY_PATH/bin/dot" $script $args
}

script_exist() {
	[[ -x "${1}/scripts/${2}/${3}" ]]
}

if args::has_no_args "$@"; then
	fzf_prompt "$(dot::list_scripts_path)"
elif args::total_is 1 "$@"; then
	fzf_prompt "$(dot::list_scripts_path | grep "/$1/")"
else
	context="$1"
	script="$2"

	shift 2

	script_path=""
	script_exist "$DOTFILES_PATH" "$context" "$script" && script_path="$DOTFILES_PATH"
	script_exist "$DOTLY_PATH" "$context" "$script" && script_path="$DOTLY_PATH"

	if [ -z "$script_path" ]; then
		output::error "The script <$context / $script> doesn't exist"
		exit 1
	fi

	"${script_path}/scripts/${context}/${script}" "$@"
fi
